<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/home_intro_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Click &amp; Drive"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_intro_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Brz i jednostavan prevoz kada ti je potreban."
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="24dp">

            <org.osmdroid.views.MapView
                android:id="@+id/vehicles_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Mapa aktivnih vozila" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/passenger_reports_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Izveštaji vožnji"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Zeleno: slobodno vozilo  •  Crveno: zauzeto vozilo\n© OpenStreetMap contributors"
            android:textAlignment="center"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <TextView
            android:id="@+id/session_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/vehicles_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Učitavanje aktivnih vozila..."
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <LinearLayout
            android:id="@+id/ride_booking_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Poruči vožnju"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/booking_favorites_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Izaberi omiljenu rutu" />

            <TextView
                android:id="@+id/booking_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Izaberi šta postavljaš, zatim dodirni tačku na mapi. Stanice se obilaze redom kojim su dodate."
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/booking_set_origin"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Polazište" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/booking_add_stop"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Stanica" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/booking_set_destination"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Odredište" />
            </LinearLayout>

            <TextView
                android:id="@+id/booking_route_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Polazište i odredište nisu izabrani."
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/booking_clear_route"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Obriši izabranu rutu" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email adrese drugih putnika (odvojene zarezom)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/booking_passenger_emails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Tip vozila" />

            <Spinner
                android:id="@+id/booking_vehicle_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/booking_baby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prevoz bebe" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/booking_pet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prevoz kućnog ljubimca" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/booking_schedule_later"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zakaži za kasnije (najviše 5 sati)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/booking_pick_time"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Izaberi datum i vreme"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/booking_demo_schedule"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Zakaži za najpopularnije vreme – 70 min" />

            <TextView
                android:id="@+id/booking_estimate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Cena će biti prikazana nakon izbora rute."
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/booking_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/booking_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Poruči vožnju" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
