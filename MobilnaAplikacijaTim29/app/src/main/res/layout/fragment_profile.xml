<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Moj profil" android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <ImageView android:id="@+id/profile_image" android:layout_width="120dp"
            android:layout_height="120dp" android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp" android:src="@mipmap/ic_launcher"
            android:scaleType="centerCrop" android:contentDescription="Profilna slika" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/profile_choose_image"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Izaberi sliku" />
            <com.google.android.material.button.MaterialButton android:id="@+id/profile_delete_image"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Ukloni sliku" />
        </LinearLayout>

        <TextView android:id="@+id/profile_pending" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Izmene čekaju odobrenje administratora."
            android:textColor="?attr/colorPrimary" android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Ime">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/profile_name"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Prezime">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/profile_surname"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Email">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/profile_email"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Pol" />
        <Spinner android:id="@+id/profile_gender" android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Adresa">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/profile_address"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Telefon">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/profile_phone"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout android:id="@+id/profile_driver_section" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/profile_block_notice"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:padding="12dp"
                android:textColor="?attr/colorError" android:textStyle="bold"
                android:visibility="gone" />
            <TextView android:id="@+id/profile_active_hours" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="Vozilo" android:textStyle="bold"
                android:textAppearance="?attr/textAppearanceTitleLarge" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Model">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/profile_vehicle_model"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Tip vozila" />
            <Spinner android:id="@+id/profile_vehicle_type" android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Registarske tablice">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/profile_vehicle_registration"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Broj mesta">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/profile_vehicle_seats"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/profile_vehicle_baby"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Prevoz beba" />
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/profile_vehicle_pet"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Prevoz kućnih ljubimaca" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/profile_save"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Sačuvaj izmene" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="Promena lozinke" android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceTitleLarge" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:hint="Trenutna lozinka">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/profile_current_password"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Nova lozinka">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/profile_new_password"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Potvrda nove lozinke">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/profile_confirm_password"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/profile_change_password"
            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:text="Promeni lozinku" />

        <TextView android:id="@+id/profile_message" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
